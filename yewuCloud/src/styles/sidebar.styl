#app {

  .main-container {
    min-height: 100%;
    transition: margin-left .28s;
    margin-left: $sideBarWidth;
    position: relative;
    background-color: #DAE3EC;
  }

  .sidebar-container {
    margin-top: 3.5417vw;
    transition: width 0.28s;
    width: $sideBarWidth !important;
    background-color: $menuBg;
    height: 100%;
    position: fixed;
    font-size: 0px;
    top: 0;
    bottom: 0;
    left: 0;
    z-index: 1001;
    overflow: hidden;

    // reset element-ui css
    .horizontal-collapse-transition {
      transition: 0s width ease-in-out, 0s padding-left ease-in-out, 0s padding-right ease-in-out;
    }

    .scrollbar-wrapper {
      overflow-x: hidden !important;
    }

    .el-scrollbar__bar.is-vertical {
      right: 0px;
    }

    .el-scrollbar {
      height: 100%;
    }

    &.has-logo {
      .el-scrollbar {
        height: calc(100% - 50px);
      }
    }

    .is-horizontal {
      display: none;
    }

    a {
      display: inline-block;
      width: 100%;
      overflow: hidden;
    }

    .svg-icon {
      margin-right: 16px;
    }

    .el-scrollbar__view {
      background-color: $menuBg;
    }

    .el-menu {
      border: none;
      height: 100%;
      width: 100% !important;
      font-size: 14px;
      --el-menu-bg-color: $menuBg;
      --el-menu-text-color: $menuText;
      --el-menu-active-color: $menuActiveText;
      --el-menu-hover-bg-color: $menuHover;
      background-color: $menuBg !important;

      .menu-item-title,
      .menu-item-title--inline {
        font-size: 14px;
      }

      .el-menu-item,
      .el-sub-menu__title {
        color: $menuText !important;
        background-color: $menuBg !important;

        &:hover {
          background-color: $menuHover !important;
        }
      }

      .el-menu-item.is-active {
        color: $menuActiveText !important;

        .svg-icon {
          color: $menuActiveText !important;
        }
      }

      &:not(.el-menu--collapse) .el-sub-menu .el-menu.el-menu--inline {
        width: 100% !important;
      }
    }

    .el-menu.el-menu--collapse {
      width: 64px !important;

      // 仅作用于侧栏一级项，避免影响 collapse 弹出的子菜单
      > .el-menu-item {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 0 !important;
        height: 56px;
        line-height: 56px;

        .menu-item-title,
        .menu-item-title--inline,
        .el-menu-item__title {
          display: none !important;
          width: 0 !important;
          height: 0 !important;
          overflow: hidden !important;
          visibility: hidden !important;
          opacity: 0 !important;
        }

        .el-menu-tooltip__trigger,
        .el-tooltip__trigger {
          display: flex !important;
          justify-content: center;
          align-items: center;
          width: 100%;
          padding: 0 !important;
        }

        .svg-icon {
          margin: 0 !important;
          font-size: 20px;
          width: 1.25em;
          height: 1.25em;
          color: $menuText;
        }
      }

      > .el-sub-menu > .el-sub-menu__title {
        display: flex !important;
        justify-content: center !important;
        align-items: center !important;
        padding: 0 !important;
        height: 56px;
        line-height: 56px;

        > span:not(.el-sub-menu__icon-arrow) {
          display: none !important;
          width: 0 !important;
          height: 0 !important;
          overflow: hidden !important;
          visibility: hidden !important;
        }

        .el-sub-menu__icon-arrow {
          display: none !important;
        }

        .svg-icon {
          margin: 0 !important;
          font-size: 20px;
          width: 1.25em;
          height: 1.25em;
          color: $menuText;
        }
      }
    }

    // menu hover
    .submenu-title-noDropdown,
    .el-submenu__title,
    .el-sub-menu__title {
      &:hover {
        background-color: $menuHover !important;
      }
    }

    .is-active>.el-submenu__title,
    .is-active>.el-sub-menu__title {
      color: $subMenuActiveText !important;
    }

    & .nest-menu .el-submenu>.el-submenu__title,
    & .nest-menu .el-sub-menu>.el-sub-menu__title,
    & .el-submenu .el-menu-item,
    & .el-sub-menu .el-menu-item {
      min-width: $sideBarWidth !important;
      background-color: $subMenuBg !important;

      &:hover {
        background-color: $subMenuHover !important;
      }
    }
  }

  .hideSidebar {
    .sidebar-container {
      width: 64px !important;
    }

    .main-container {
      margin-left: 64px;
    }
  }

  .el-menu--collapse > .el-submenu,
  .el-menu--collapse > .el-sub-menu {
    min-width: 64px !important;
  }

  // 收缩态弹出的子菜单（teleport 到 body 后仍须全局生效）
  .el-menu--popup,
  .el-menu--popup-container .el-menu {
    min-width: $sideBarWidth !important;
    font-size: 14px;
    background-color: $subMenuBg !important;

    .menu-item-title,
    .menu-item-title--inline,
    .el-menu-item__title {
      display: inline !important;
      width: auto !important;
      height: auto !important;
      overflow: visible !important;
      visibility: visible !important;
      opacity: 1 !important;
      font-size: 14px;
    }

    .el-menu-item {
      display: flex !important;
      justify-content: flex-start !important;
      align-items: center !important;
      padding: 0 20px !important;
      height: 56px;
      line-height: 56px;
      min-width: $sideBarWidth !important;
      color: $menuText !important;
      background-color: $subMenuBg !important;

      &:hover {
        background-color: $subMenuHover !important;
      }

      &.is-active {
        color: $menuActiveText !important;
      }

      .svg-icon {
        margin-right: 16px !important;
        font-size: 18px;
        width: 1em;
        height: 1em;
        flex-shrink: 0;
      }
    }
  }

  // 驾驶舱无左侧菜单，主内容区占满宽度
  .app-wrapper--dashboard {
    .main-container {
      margin-left: 0;
    }

    &.hideSidebar .main-container {
      margin-left: 0;
    }
  }

  // mobile responsive
  .mobile {
    .main-container {
      margin-left: 0px;
    }

    &.hideSidebar {
      .sidebar-container {
        pointer-events: none;
        transition-duration: 0.3s;
        width: 0 !important;
        transform: translate3d(-$sideBarWidth, 0, 0);
      }
    }
  }

  .withoutAnimation {

    .main-container,
    .sidebar-container {
      transition: none;
    }
  }
}

// when menu collapsed
.el-menu--vertical {
  &>.el-menu {
    .svg-icon {
      margin-right: 16px;
    }
  }

  .nest-menu .el-submenu>.el-submenu__title,
  .nest-menu .el-sub-menu>.el-sub-menu__title,
  .el-menu-item {
    &:hover {
      // you can use $subMenuHover
      background-color: $menuHover !important;
    }
  }

  // the scroll bar appears when the subMenu is too long
  >.el-menu--popup {
    max-height: 100vh;
    overflow-y: auto;

    &::-webkit-scrollbar-track-piece {
      background: #d3dce6;
    }

    &::-webkit-scrollbar {
      width: 6px;
    }

    &::-webkit-scrollbar-thumb {
      background: #99a9bf;
      border-radius: 20px;
    }
  }
}
